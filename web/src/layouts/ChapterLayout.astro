---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ChapterNav from '../components/ChapterNav.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import InteractiveDiagrams from '../components/InteractiveDiagrams.astro';
import { type ChapterConfig, type PartConfig, isFirstChapterOfPart } from '../book.config';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  chapterNumber: number;
  slug: string;
  headings: Heading[];
  prev: ChapterConfig | null;
  next: ChapterConfig | null;
  part: PartConfig | undefined;
}

const { title, description, chapterNumber, slug, headings, prev, next, part } = Astro.props;
const showPartHeader = part && isFirstChapterOfPart(chapterNumber);
---

<BaseLayout title={`فصل ${chapterNumber}. ${title} | Claude Code من المصدر`} description={description}>
  <ReadingProgress />
  <Header />

  <div id="chapter-layout" class="flex max-w-[90rem] mx-auto">
    <Sidebar currentSlug={slug} />

    <main class="flex-1 min-w-0 px-4 md:px-8 lg:px-12 py-8 transition-all duration-200">
      {showPartHeader && (
        <div class="mb-8 pb-6 border-b border-[var(--color-border)] dark:border-[#333]">
          <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-terracotta)] mb-1 font-[var(--font-arabic)]">الجزء {part!.number}</p>
          <h2 class="text-2xl font-bold text-[var(--color-charcoal)] dark:text-[var(--color-cream)] font-[var(--font-arabic)]">{part!.title}</h2>
          <p class="text-sm italic text-[var(--color-muted)] mt-2 font-[var(--font-arabic)]">{part!.epigraph}</p>
        </div>
      )}

      <article class="chapter-prose">
        <slot />
      </article>

      <InteractiveDiagrams chapterNumber={chapterNumber} />

      <ChapterNav prev={prev} next={next} />

      <!-- Attribution Footer -->
      <footer class="mt-16 pt-8 pb-12 border-t border-[var(--color-border)] dark:border-[#333] text-center text-xs text-[var(--color-muted)] font-[var(--font-arabic)] space-y-2">
        <p>
          العمل الأصلي: <a href="https://claude-code-from-source.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-terracotta)] hover:underline font-medium">Claude Code from Source</a> تأليف <a href="https://github.com/alejandrobalderas" target="_blank" rel="noopener noreferrer" class="text-[var(--color-terracotta)] hover:underline font-medium">Alejandro Balderas</a> (<a href="https://github.com/alejandrobalderas/claude-code-from-source" target="_blank" rel="noopener noreferrer" class="hover:underline">المستودع الأصلي</a>)
        </p>
        <p>
          الترجمة العربية بواسطة <a href="https://github.com/mostafazh" target="_blank" rel="noopener noreferrer" class="text-[var(--color-terracotta)] hover:underline">مصطفى زاهر</a> ومساهمي المجتمع • مرخصة بموجب <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="hover:underline">CC BY-NC-SA 4.0</a> (استخدام تعليمي غير تجاري)
        </p>
      </footer>
    </main>

    <TableOfContents headings={headings} />
  </div>

  <!-- Client-side scripts -->
  <script src="../scripts/copy-code.ts"></script>
  <script src="../scripts/focus-mode.ts"></script>
</BaseLayout>
